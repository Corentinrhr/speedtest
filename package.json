{
  "name": "librespeed-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "prestart": "node ./setup-env.js",
    "start": "concurrently \"node server.dev.js\" \"ng serve --configuration development --project librespeed-frontend\"",
    "start:backend": "node server.dev.js",
    "start:frontend": "ng serve --configuration development --project librespeed-frontend",
    "prebuild": "node ./setup-env.js",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "lint": "ng lint"
  },
  "dependencies": {
    "@angular/animations": "^20.0.0",
    "@angular/cdk": "^20.0.0",
    "@angular/common": "^20.0.0",
    "@angular/compiler": "^20.0.0",
    "@angular/core": "^20.0.0",
    "@angular/forms": "^20.0.0",
    "@angular/platform-browser": "^20.0.0",
    "@angular/platform-browser-dynamic": "^20.0.0",
    "@angular/router": "^20.0.0",
    "@primeuix/themes": "^1.2.5",
    "chart.js": "^4.4.0",
    "dotenv": "^16.4.5",
    "primeicons": "^7.0.0",
    "primeng": "^20.1.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.6.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.0.0",
    "@angular/cli": "^20.0.0",
    "@angular/compiler-cli": "^20.0.0",
    "@types/jest": "^30.0.0",
    "concurrently": "^9.0.0",
    "typescript": "~5.8.0"
  },
  "overrides": {
    "@angular/animations": "$@angular/animations",
    "@angular/cdk": "$@angular/cdk",
    "@angular/common": "$@angular/common",
    "@angular/compiler": "$@angular/compiler",
    "@angular/core": "$@angular/core",
    "@angular/forms": "$@angular/forms",
    "@angular/platform-browser": "$@angular/platform-browser",
    "@angular/platform-browser-dynamic": "$@angular/platform-browser-dynamic",
    "@angular/router": "$@angular/router"
  }
}
